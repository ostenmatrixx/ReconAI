{
  "name": "@workspace/reconciliation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark": "tsx src/benchmark.ts",
    "verify:load": "node --import tsx src/load-verification.ts",
    "evaluate:collisions": "tsx src/collision-evaluation.ts",
    "evaluate:identifiers": "tsx src/identifier-evaluation.ts",
    "evaluate:taxonomy": "tsx src/taxonomy-evaluation.ts"
  },
  "dependencies": {
    "@workspace/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/test-support": "workspace:*",
    "fast-check": "4.9.0",
    "tsx": "4.23.4",
    "typescript": "catalog:"
  }
}
