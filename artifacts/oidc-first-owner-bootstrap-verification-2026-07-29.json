    {
      "boundary": "successful invitation acceptance",
      "observed": "The acceptance BFF returned the accepted membership but did not select the organization, so the invited identity reached a context-required dashboard instead of its authorized tenant.",
      "resolution": "The BFF now strictly validates the successful upstream response and issues the existing subject-bound, HttpOnly, SameSite=Lax organization-context cookie only for a valid 201 result. Rejected and malformed upstream responses never receive a context cookie."
    },
    {
      "boundary": "successful acceptance response validation",
      "observed": "A nominal upstream success was not runtime-validated before becoming browser authority.",
      "resolution": "The BFF now rejects malformed success payloads with a private 502 response and tests valid, rejected, malformed, cross-site, subjectless, expired, and malformed-request paths."
    },
    {
      "boundary": "local identity fixture",
      "observed": "The original realm and validator represented only the first owner identity.",
      "resolution": "The isolated realm now contains exactly two reserved, enabled, verified synthetic identities with temporary passwords, and the validator fails on extra, missing, unverified, disabled, or non-reserved users."
    },
    {
      "boundary": "ephemeral browser evidence under the development compiler",
      "observed": "First compilation of the state-changing BFF could refresh the settings component after a one-time invitation token was returned.",
      "resolution": "The verifier compiles the BFF boundary before requesting the only browser copy of an invitation token and uses response-bound, uniquely scoped membership and invitation assertions."
