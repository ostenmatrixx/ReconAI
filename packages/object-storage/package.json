  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@workspace/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.1",
    "typescript": "catalog:"
  }
}
