NODE_ENV=development
APP_ENV=development

WEB_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
API_ORIGIN=http://localhost:4000
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
# Composite PostgreSQL, Redis, and object-storage readiness budget.
API_READINESS_TIMEOUT_MS=1000
# Direct local API traffic trusts no forwarding headers and uses the bounded in-process limiter.
# Production requires explicit proxy CIDRs, Redis, and canonical base64url for 32–64 random bytes.
API_TRUST_PROXY_CIDRS=
API_RATE_LIMIT_STORE=local
API_RATE_LIMIT_KEY_SECRET=
API_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=1000
API_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=1000
# Application deadline plus PostgreSQL statement backstop for one run-authority transaction.
RECONCILIATION_RUN_TRANSACTION_TIMEOUT_MS=30000
# Per-API-process fail-fast cap for heavyweight run-authority transactions.
RECONCILIATION_RUN_MAX_CONCURRENT_TRANSACTIONS=2

DATABASE_URL=postgresql://reconai_app:local-app-only@127.0.0.1:5432/reconai
DATABASE_WORKER_URL=postgresql://reconai_worker:local-worker-only@127.0.0.1:5432/reconai
DATABASE_MAINTENANCE_URL=postgresql://reconai_maintenance:local-maintenance-only@127.0.0.1:5432/reconai
DATABASE_MIGRATION_URL=postgresql://reconai_migrator:local-migrator-only@127.0.0.1:5432/reconai
# Development fixture/integration bootstrap only; applications never receive this credential.
DATABASE_ADMIN_URL=postgresql://postgres:local-postgres-only@127.0.0.1:5432/reconai
REDIS_URL=redis://127.0.0.1:6379
DURABLE_QUEUE_MONITOR_INTERVAL_MS=15000
DURABLE_QUEUE_MONITOR_REDIS_CONNECT_TIMEOUT_MS=1000
DURABLE_QUEUE_MONITOR_REDIS_COMMAND_TIMEOUT_MS=1000
# Distributed, per-tenant/connection provider page-request circuit. It is always active.
PROVIDER_CIRCUIT_REDIS_CONNECT_TIMEOUT_MS=1000
PROVIDER_CIRCUIT_REDIS_COMMAND_TIMEOUT_MS=1000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_MS=60000
PROVIDER_CIRCUIT_PROBE_LEASE_MS=15000

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reconai-development
S3_ACCESS_KEY_ID=local-minio-only
S3_SECRET_ACCESS_KEY=local-minio-secret-only
S3_FORCE_PATH_STYLE=true
# Production must set AES256 or aws:kms; local MinIO leaves this blank.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

OIDC_ISSUER=http://127.0.0.1:8080/realms/reconai-development
OIDC_CLIENT_ID=reconai-web-development
OIDC_CLIENT_SECRET=local-oidc-secret-only
OIDC_ID_TOKEN_SIGNING_ALGORITHM=RS256
# Optional non-essential OIDC ACR request. The API must still verify the resulting exact `acr`.
OIDC_ACR_VALUES=
# Restricted support diagnostics are disabled by default. Enabling requires an exact OIDC group,
# an MFA assurance-context claim, and a dedicated 32–64 byte base64url identity-index key.
SUPPORT_ACCESS_ENABLED=false
SUPPORT_OIDC_GROUP=
SUPPORT_OIDC_AUTHENTICATION_CONTEXT=
SUPPORT_IDENTITY_HMAC_KEY=
SESSION_SECRET=replace-with-at-least-32-random-bytes-for-nonlocal-use
SESSION_COOKIE_SECURE=false
# Process-local revocation is suitable only for one-process development. Production requires Redis
# so provider-initiated logout is enforced consistently by every web instance.
SESSION_REVOCATION_STORE=local
SESSION_REVOCATION_REDIS_CONNECT_TIMEOUT_MS=1000
SESSION_REVOCATION_REDIS_COMMAND_TIMEOUT_MS=1000
RECONAI_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Comma-separated secret-manager key references. Raw production key material must not be stored here.
CONNECTOR_ENCRYPTION_KEYS=v1=env:RECONAI_CONNECTOR_ENCRYPTION_KEY_V1
CONNECTOR_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# Development-only all-zero 32-byte base64url key. Production startup rejects this value.
RECONAI_CONNECTOR_ENCRYPTION_KEY_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

SHOPIFY_OAUTH_ENABLED=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_SCOPES=read_orders
SHOPIFY_API_VERSION=2026-07
STRIPE_OAUTH_ENABLED=false
STRIPE_OAUTH_CLIENT_ID=
STRIPE_OAUTH_SECRET_KEY=
STRIPE_APP_ID=
STRIPE_APP_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
# Local fixture connection secret references; replace with distinct per-connection injected values.
RECONAI_CONNECTOR_SHOPIFY_DEVELOPMENT=synthetic-shopify-webhook-secret-only
RECONAI_CONNECTOR_STRIPE_DEVELOPMENT=whsec_synthetic-stripe-webhook-secret-only
# Read credentials are separate from webhook signing secrets. A connection is sync-enabled only if
# its api_credential_reference explicitly points to one of these environment references.
RECONAI_CONNECTOR_SHOPIFY_READ_DEVELOPMENT=synthetic-shopify-read-credential-only
RECONAI_CONNECTOR_STRIPE_READ_DEVELOPMENT=synthetic-stripe-read-credential-only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
OTEL_EXPORT_TIMEOUT_MS=5000
LOG_LEVEL=info

# Invitation email is disabled locally. The HTTP relay receives a bounded message over an
# authenticated request; raw invitation tokens are never persisted or logged.
EMAIL_PROVIDER=disabled
EMAIL_WEBHOOK_URL=
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM=
EMAIL_REQUEST_TIMEOUT_MS=5000

# Periodic provider repair is opt-in. It creates only bounded read-only gap-repair runs.
PROVIDER_GAP_REPAIR_ENABLED=false
PROVIDER_GAP_REPAIR_INTERVAL_MS=900000
PROVIDER_GAP_REPAIR_LOOKBACK_MS=86400000
PROVIDER_GAP_REPAIR_OVERLAP_MS=300000
PROVIDER_GAP_REPAIR_MAXIMUM_PAGES=5
PROVIDER_GAP_REPAIR_BATCH_SIZE=25

# Mandatory Shopify privacy deadlines are scanned by default. New threshold signals are
# append-only and emitted as aggregate warning/error logs; configure an alert sink in production.
PROVIDER_PRIVACY_DEADLINE_MONITOR_ENABLED=true
PROVIDER_PRIVACY_DEADLINE_MONITOR_INTERVAL_MS=900000
PROVIDER_PRIVACY_DEADLINE_MONITOR_BATCH_SIZE=100

AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=5000
AI_MAX_COST_MINOR=0
