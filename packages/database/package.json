{
  "name": "@workspace/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:verify-restore": "tsx src/verify-restore.ts"
  },
  "dependencies": {
    "@workspace/connector-csv": "workspace:*",
    "@workspace/connectors": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/ingestion": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/object-storage": "workspace:*",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.4",
    "typescript": "catalog:"
  }
}
