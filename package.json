{
  "name": "reconai-working-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Working-name repository for an open-source, multi-tenant reconciliation system",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "node scripts/run-with-local-env.mjs pnpm --parallel --filter './apps/*' dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --project unit --project tenant --project reconciliation",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-with-local-env.mjs pnpm exec vitest run --project integration",
    "test:tenant": "vitest run --project tenant",
    "tenant:check": "tsx --conditions=development scripts/validate-tenant-surfaces.mjs",
    "test:reconciliation": "vitest run --project reconciliation",
    "benchmark:reconciliation": "pnpm --filter @workspace/reconciliation benchmark",
    "verify:reconciliation-load": "pnpm --filter @workspace/reconciliation verify:load",
    "test:e2e": "pnpm --filter @workspace/web test:e2e",
    "test:accessibility": "pnpm --filter @workspace/web test:accessibility",
    "verify:live-edge": "node scripts/verify-live-edge.mjs",
    "verify:live-api-rate-limit": "pnpm --filter '@workspace/api...' build && node scripts/run-with-local-env.mjs node scripts/verify-live-api-rate-limit.mjs",
    "verify:live-readiness": "node scripts/run-with-local-env.mjs node scripts/verify-live-api-readiness.mjs",
    "verify:live-reconciliation": "node scripts/run-with-local-env.mjs node scripts/verify-live-reconciliation-journey.mjs",
    "verify:live-oidc-bootstrap": "node scripts/run-with-local-env.mjs node scripts/verify-live-oidc-bootstrap.mjs",
    "verify:live-oidc-support": "pnpm exec tsx --conditions=development scripts/verify-live-oidc-support.mjs",
    "verify:live-organization-directory": "node scripts/run-with-local-env.mjs pnpm exec tsx --conditions=development scripts/verify-live-organization-directory.mjs",
    "verify:live-organization-directory-ceiling": "LIVE_ORGANIZATION_DIRECTORY_MEMBERSHIPS=501 node scripts/run-with-local-env.mjs pnpm exec tsx --conditions=development scripts/verify-live-organization-directory.mjs",
    "verify:live-oidc-distributed": "node scripts/run-with-local-env.mjs node scripts/verify-live-oidc-distributed.mjs",
    "verify:live-oidc-lifecycle": "node scripts/run-with-local-env.mjs node scripts/verify-live-oidc-lifecycle.mjs",
    "verify:organization-profile": "node scripts/verify-organization-profile.mjs",
    "verify:reconciliation-input-pagination": "tsx --conditions=development scripts/verify-reconciliation-input-pagination.mjs",
    "verify:reconciliation-run-creation": "tsx --conditions=development scripts/verify-reconciliation-run-creation.mjs",
    "verify:clean-source": "node scripts/verify-clean-source.mjs",
    "verify:literal-clone": "node scripts/verify-literal-clone.mjs",
    "verify:local-candidate": "node scripts/verify-local-release-candidate.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm migrations:check && pnpm schemas:check && pnpm tenant:check && pnpm config:check && pnpm edge:check && pnpm oidc:check && pnpm container:check && pnpm alerts:check && pnpm source:check && pnpm evidence:check && pnpm dependency:policy && pnpm license:check && pnpm build",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit",
    "hooks:pre-push": "lefthook run pre-push",
    "infra:up": "node scripts/run-compose.mjs up",
    "infra:down": "node scripts/run-compose.mjs down",
    "infra:logs": "node scripts/run-compose.mjs logs",
    "db:migrate": "node scripts/run-with-local-env.mjs pnpm --filter @workspace/database db:migrate",
    "db:generate": "node scripts/run-with-local-env.mjs pnpm --filter @workspace/database db:generate",
    "backup:verify": "pnpm --filter @workspace/database db:verify-restore",
    "backup:verify-objects": "pnpm --filter @workspace/object-storage object:verify-restore",
    "backup:rebuild-queue": "pnpm --filter @workspace/worker recovery:rebuild-queue",
    "backup:rebuild-unpublished-queue": "pnpm --filter @workspace/worker recovery:rebuild-unpublished-queue",
    "repair:source-classifications": "pnpm --filter @workspace/worker repair:source-classifications",
    "activate:source-classification-fence": "pnpm --filter @workspace/worker activate:source-classification-fence",
    "fixtures:load": "node scripts/run-with-local-env.mjs pnpm --filter @workspace/test-support fixtures:load",
    "connector:credential:seal": "tsx packages/connectors/src/seal-credential.ts",
    "migrations:check": "node scripts/validate-migrations.mjs",
    "schemas:check": "node scripts/validate-schemas.mjs",
    "config:check": "node scripts/validate-config.mjs",
    "edge:check": "node scripts/validate-edge-security.mjs",
    "oidc:check": "node scripts/validate-oidc-security.mjs",
    "container:check": "node scripts/validate-container-integrity.mjs",
    "alerts:check": "tsx scripts/validate-operational-alert-policy.mjs",
    "source:check": "node scripts/validate-source-boundary.mjs",
    "evidence:check": "node scripts/validate-evidence.mjs",
    "dependency:policy": "node scripts/check-dependency-policy.mjs",
    "license:check": "node scripts/validate-licenses.mjs",
    "license:inventory": "node scripts/generate-production-license-inventory.mjs --write",
    "secret:scan": "secretlint '**/*' --maskSecrets",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --prod --out artifacts/sbom.cdx.json --sbom-type application --sbom-supplier ReconAI",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "24.10.12",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
